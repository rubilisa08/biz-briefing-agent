# .env 로 복사해서 값을 채운다. .env 는 .gitignore 에 있어 GitHub에 올라가지 않는다.
# 이 파일(.env.example)에는 실제 값을 넣지 않는다.
# GitHub Actions 에서는 같은 값을 레포 Settings → Secrets and variables → Actions 에 넣는다.

# Discord 웹훅 주소 (Actions Secret 이름: WEBHOOK_URL)
DISCORD_WEBHOOK_URL=

# Google AI Studio 에서 받은 Gemini API 키 — 요약·인사이트·환각 검수용 (Actions Secret 이름: GEMINI_API_KEY)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
